{
  "name": "three-doom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify:wad": "tsx scripts/verify-wad.ts",
    "setup:wad": "node scripts/setup-wad.mjs",
    "reference:manifest": "node scripts/reference-manifest.mjs",
    "inventory:specials": "tsx scripts/inventory-specials.ts",
    "verify:audio": "tsx scripts/verify-audio.ts",
    "reference:world": "node scripts/reference-world.mjs",
    "compare:world": "tsx scripts/compare-world.ts --check"
  },
  "dependencies": {
    "crashcat": "^0.0.2",
    "earcut": "^3.0.2",
    "koota": "^0.6.5",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.183.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "wrangler": "^4.71.0"
  },
  "packageManager": "npm@11.16.0"
}
